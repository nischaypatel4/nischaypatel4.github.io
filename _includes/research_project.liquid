{% assign project = include.project %}
{% if project.redirect contains '://' %}
  {% assign project_link = project.redirect %}
{% else %}
  {% assign project_link = project.url | relative_url %}
{% endif %}
<article class="research-project{% if project.img %} has-image{% endif %}">
  {% if project.img %}
    <img src="{{ project.img | relative_url }}" alt="" width="240" height="160" loading="lazy">
  {% endif %}
  <div>
    <h3>
      <a href="{{ project_link }}">{{ project.title }}</a>
    </h3>
    <p>{{ project.description }}</p>
    <a class="research-text-link" href="{{ project_link }}">
      {%- if project.redirect contains 'github.com' -%}
        View code
      {%- elsif project.redirect contains 'doi.org' -%}
        Read paper
      {%- else -%}
        Explore project
      {%- endif %}
      <span aria-hidden="true">&rarr;</span></a
    >
    {% if project.github and project.github != project_link %}
      <a class="research-text-link project-code" href="{{ project.github }}">View code <span aria-hidden="true">&rarr;</span></a>
    {% endif %}
  </div>
</article>
